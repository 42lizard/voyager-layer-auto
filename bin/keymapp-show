#!/usr/bin/python3
"""Reveal Keymapp from the app launcher without starting duplicate instances."""
import fcntl
import json
import os
from pathlib import Path
import subprocess
import time


def state(command):
    return json.loads(subprocess.check_output(['hyprctl', command, '-j'], text=True))


def main():
    lock_path = Path(os.environ['XDG_RUNTIME_DIR']) / 'keymapp-show.lock'
    with lock_path.open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        monitor = next(m for m in state('monitors') if m['focused'])
        workspace = monitor['activeWorkspace']['id']
        for attempt in range(100):
            windows = [w for w in state('clients') if w['class'] == 'keymapp']
            if windows:
                window = windows[0]
                selector = json.dumps('address:' + window['address'])
                commands = []
                if window['workspace']['id'] != workspace:
                    commands.append('hl.dispatch(hl.dsp.window.move({'
                                    f'workspace = "{workspace}", window = {selector}, follow = false'
                                    '}))')
                if window['floating']:
                    commands.append('hl.dispatch(hl.dsp.window.float({'
                                    f'action = "disable", window = {selector}'
                                    '}))')
                commands.append(f'hl.dispatch(hl.dsp.focus({{window = {selector}}}))')
                subprocess.run(['hyprctl', 'eval', '; '.join(commands)], check=True)
                return
            if attempt == 0:
                running = subprocess.run(['pgrep', '-u', str(os.getuid()), '-x', 'keymapp'],
                                         stdout=subprocess.DEVNULL).returncode == 0
                if not running:
                    subprocess.Popen(['keymapp'], start_new_session=True,
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(0.1)
        raise SystemExit('Keymapp did not create a window within 10 seconds')


if __name__ == '__main__':
    main()
